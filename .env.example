# Password required to open the site.
# Keep the quotes: a bare "#" would be read as the start of a comment.
APP_PASSWORD="change-me"

# Apify API token (https://console.apify.com/account/integrations)
APIFY_TOKEN="apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Optional override. Defaults to xquik/x-reply-scraper, which works on Apify's
# free plan and returns author follower counts + verification flags.
APIFY_ACTOR="xquik/x-reply-scraper"
